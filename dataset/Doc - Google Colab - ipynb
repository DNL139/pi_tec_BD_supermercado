      "source": [
        "# ==========================\n",
        "# 3.1 Conversão de tipos\n",
        "# ==========================\n",
        "\n",
        "# Converter coluna Date para datetime\n",
        "df['Date'] = pd.to_datetime(df['Date'], format='%m/%d/%Y')\n",
